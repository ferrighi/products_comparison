{
    "name": "metno/products_comparison",
    "type": "drupal-custom-module",
    "description": "Drupal tool for comparsion of two Sentinel-2 products on a OpenLayers map.",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "sniff": "phpcs --colors -n --standard=Drupal --extensions=php,module,yml src",
        "snifferfix": "phpcbf --colors -n --standard=Drupal --extensions=php,module,yml src"
    },
    "authors": [
        {
            "name": "Lara Ferrighi",
            "email": "laraf@met.no"
        },
        {
            "name": "Magnar Martinsen",
            "email": "magnarem@met.no"
        }
    ],

    "require": {
        "metno/metsis_drupal": "4.x@dev",
        "drupal/vite": "^1.5"
    },
    "require-dev": {
        "metno/mmd": "^4",
        "drush/drush": "^13.0"
    }
}
